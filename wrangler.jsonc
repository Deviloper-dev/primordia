// Cloudflare Workers static-assets deploy (used by Cloudflare's Git integration: `npx wrangler deploy`).
// Pure static site: the build output is uploaded as-is, no Worker script or Vite plugin needed.
{
  "name": "primordia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
